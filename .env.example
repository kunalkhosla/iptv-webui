# Primary Xtream Codes panel host (no trailing slash, include port if non-80/443)
IPTV_HOST=http://your-primary-panel-host

# Optional fallback hosts (comma-separated) sharing the same credentials.
# On startup and refresh, we probe primary first; if it fails auth or is
# unreachable, we cycle through the fallbacks. The /api/proxy route also
# tries each fallback host whenever an .m3u8 manifest fetch returns empty
# from the active host.
IPTV_HOST_FALLBACK=http://secondary1.example,http://secondary2.example

# Xtream credentials. Seed the owner account on first boot; after that
# the live source of truth is the encrypted data/panel-config.json
# (rewritten whenever the owner edits panel creds via the UI).
IPTV_USER=your_username
IPTV_PASS=your_password

# Owner account seed. Used ONLY on first boot to bootstrap
# data/accounts.json with user "u1" (the owner). After that, the
# scrypt-hashed password on disk is what authenticates — changing
# these env vars does not change the owner password. Subsequent users
# self-register via invite links (Settings → Profile → Invite a friend…).
APP_USER=admin
APP_PASS=change-me

# Optional
PORT=3000

# Strongly recommended; REQUIRED for multi-user installs. Used to:
#   1. Sign session + profile cookies (stable across restarts).
#   2. Sign /api/proxy and /api/transcode media URLs.
#   3. Derive the AES-GCM key that seals every non-owner user's panel
#      credentials in data/accounts.json.
# When unset, the server falls back to a random-per-process secret —
# acceptable for single-user dev, but every restart invalidates all
# sessions, and the server refuses to boot if any member user exists
# (their sealed creds would be unreadable).
PROXY_SECRET=

# Optional: TMDB v4 read-access token. When set, the server enriches
# movie/series posters, backdrops, plots, ratings, runtimes, genres,
# and per-season episode stills (artwork primary, metadata only fills
# what the panel left blank). Lookups are cached in data/tmdb-cache.json.
# Without this key everything still works; the UI just falls back to
# whatever artwork the panel ships.
#
# Register your own key — TMDB issues one per account and the upstream
# repo does not (and cannot) share theirs. Free, takes ~2 minutes:
#   https://www.themoviedb.org/settings/api → "API Read Access Token"
TMDB_API_KEY=

# Optional: visible-channel codec/liveness probe sweep. When the TV
# Guide renders, the IntersectionObserver coalesces visible ids and
# POSTs them to /api/probe-channels — server runs ffprobe + manifest
# liveness checks and the inline off-air marker populates. OFF by
# default because most reseller panels enforce max_connections=1
# softly and don't reap stale sessions promptly, so even short-lived
# probes climb active_cons faster than the panel decrements it.
# Set to "1" or "true" to enable on panels with > 1 real slot.
PROBE_CHANNELS_ENABLED=

# Optional: Anthropic API key for the AI features — the per-profile
# "For You" home rail (nightly taste profiles) and the natural-language
# search fallback ("something funny for the kids"). Uses Claude Haiku;
# a household's typical usage costs pennies per month. Without the key
# both features are silently absent. AI_MODEL overrides the model id.
ANTHROPIC_API_KEY=
AI_MODEL=

# Optional: local media library for the owner-only "Disk" section.
# Absolute path INSIDE the container (mount the host folder read-only in
# docker-compose.yml). When set (owner account only), Khouch scans it,
# ffprobes each file once, enriches via TMDB, and serves a 4th "Disk"
# section alongside Live / Movies / Series. Leave blank to disable.
DISK_MEDIA_DIR=
