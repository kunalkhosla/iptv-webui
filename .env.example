# Primary Xtream Codes panel host (no trailing slash, include port if non-80/443)
IPTV_HOST=http://your-primary-panel-host

# Optional fallback hosts (comma-separated) sharing the same credentials.
# On startup and refresh, we probe primary first; if it fails auth or is
# unreachable, we cycle through the fallbacks. The /api/proxy route also
# tries each fallback host whenever an .m3u8 manifest fetch returns empty
# from the active host.
IPTV_HOST_FALLBACK=http://secondary1.example,http://secondary2.example

# Xtream credentials
IPTV_USER=your_username
IPTV_PASS=your_password

# HTTP Basic Auth gate for the web UI itself
APP_USER=admin
APP_PASS=change-me

# Optional
PORT=3000

# Optional: TMDB v4 read-access token. When set, the server enriches
# movie/series posters, backdrops, plots, ratings, runtimes, genres,
# and per-season episode stills (artwork primary, metadata only fills
# what the panel left blank). Lookups are cached in data/tmdb-cache.json.
# Without this key everything still works; the UI just falls back to
# whatever artwork the panel ships.
#
# Register your own key — TMDB issues one per account and the upstream
# repo does not (and cannot) share theirs. Free, takes ~2 minutes:
#   https://www.themoviedb.org/settings/api → "API Read Access Token"
TMDB_API_KEY=

# Optional: visible-channel codec/liveness probe sweep. When the TV
# Guide renders, the IntersectionObserver coalesces visible ids and
# POSTs them to /api/probe-channels — server runs ffprobe + manifest
# liveness checks and the inline off-air marker populates. OFF by
# default because most reseller panels enforce max_connections=1
# softly and don't reap stale sessions promptly, so even short-lived
# probes climb active_cons faster than the panel decrements it.
# Set to "1" or "true" to enable on panels with > 1 real slot.
PROBE_CHANNELS_ENABLED=
